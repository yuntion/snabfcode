 func (r *Runtime) Decode(ct *rlwe.Ciphertext) ([]float64, error) {
-	if ct.Value[0].N() != r.Program.Target {
+	if ct == nil || ct.MetaData == nil || len(ct.Value) == 0 || ct.Value[0].N() != r.Program.Target || ct.Slots() != r.Program.Slots {
 		return nil, fmt.Errorf("wrong result key domain")
 	}
 	v := make([]float64, r.Program.Slots)
diff --git a/src/backend/ringswitch/epochs/heir_error.go b/src/backend/ringswitch/epochs/heir_error.go
new file mode 100644
index 0000000..2ad8e26
--- /dev/null
+++ b/src/backend/ringswitch/epochs/heir_error.go
@@ -0,0 +1,20 @@
+package epochs
+
+import (
+	"fmt"
+	"runtime"
+)
+
+// Upstream HEIR panics on Lattigo error returns. Keep the generated public
+// Eval error ABI without hiding programmer errors (bounds, nil dereferences).
+func HEIRError(site *string, err *error) {
+	if v := recover(); v != nil {
+		if e, ok := v.(error); ok {
+			if _, fault := e.(runtime.Error); !fault {
+				*err = fmt.Errorf("%s: %w", *site, e)
+				return
+			}
+		}
+		panic(v)
+	}
+}
