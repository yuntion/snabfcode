diff --git a/src/compiler/Target/Lattigo/DirectGo.cpp b/src/compiler/Target/Lattigo/DirectGo.cpp
new file mode 100644
index 0000000..2c5e37b
--- /dev/null
+++ b/src/compiler/Target/Lattigo/DirectGo.cpp
@@ -0,0 +1,131 @@
+#include "DirectEmitter.h"
+#include "EmitGraph.h"
+#include <charconv>
+#include <cmath>
+
+namespace snabf::ir::lattigo_target::detail {
+namespace {
+std::string quoted(StringRef s) {
+  static constexpr char hex[] = "0123456789abcdef";
+  std::string out(1,'"');
+  for (unsigned char c:s.bytes()) {
+    if (c=='\\' || c=='"') {out+='\\'; out+=c;}
+    else if (c>=32 && c<127) out+=c;
+    else {out+="\\x"; out+=hex[c>>4]; out+=hex[c&15];}
+  }
+  return out+'"';
+}
+// Round-trip the actual binary64 bound/coefficient, independent of locale.
+std::string number(double x) {
+  require(std::isfinite(x),"nonfinite_go_literal");
+  char buf[64]; auto r=std::to_chars(buf,buf+sizeof(buf),x);
+  require(r.ec==std::errc(),"unrepresentable_go_literal");
+  return std::string(buf,r.ptr);
+}
+template<class Range> void list(llvm::raw_ostream &o,StringRef type,const Range &xs) {
+  o<<"[]"<<type<<"{";
+  for(auto &x:xs) {
+    if constexpr (std::is_floating_point_v<std::decay_t<decltype(x)>>) o<<number(x);
+    else o<<x;
+    o<<",";
+  }
+  o<<"}";
+}
+void layout(llvm::raw_ostream &o,DictionaryAttr d) {
+  o<<"epoch.Layout{N:"<<num(d,"ring_dim")<<", Capacity:"<<num(d,"num_slots")
+   <<", Width:"<<num(d,"logical_width")<<", Period:"<<num(d,"period")<<", Stride:"<<num(d,"stride")
+   <<", Level:"<<num(d,"active_level")<<", Lanes:"<<num(d,"lane_count")<<", Packing:"<<quoted(str(d,"packing_mode"))
+   <<", LogScale:"<<number(real(d,"log2_scale"))<<", Offsets:";list(o,"int",ints(d,"offsets"));
+  o<<", Active:";list(o,"int",ints(d,"active_lanes"));o<<", Mask:";list(o,"int",ints(d,"mask_signature"));o<<"}";
+}
+void bind(llvm::raw_ostream &o,const EmitGraph &g,StringRef digest) {
+  o<<"const PlanSHA256 = "<<quoted(digest)<<"\n\nfunc New() (*epoch.Runtime, error) {\n"
+    "\treturn epoch.Bind(epoch.Program{Fingerprint: PlanSHA256, Source:"<<g.source<<", Target:"<<g.target
+   <<", Width:"<<g.width<<", Slots:"<<g.slots<<", GaloisBytes:"<<num(g.program,"galois_bytes")<<",\n\t\tEpochs: []epoch.Epoch{\n";
+  for (auto [n,d]:g.families) {
+    o<<"\t\t\t{N:"<<n<<", Scale:"<<num(d,"scale")<<", KeyID:"<<quoted(str(d,"key_id"))<<", KeyBytes:"
+     <<num(d,"key_bytes")<<", Relin:"<<(g.relin.count(n)?"true":"false")<<", Q:";list(o,"uint64",ints(d,"q"));
+    o<<", P:";list(o,"uint64",ints(d,"p"));o<<", Galois:";list(o,"uint64",ints(d,"galois"));o<<"},\n";
+  }
+  o<<"\t\t},\n";
+  if (auto d=g.transition) {
+    o<<"\t\tSwitch: &epoch.Transition{FromKey:"<<quoted(str(d,"source_key"))<<", ToKey:"<<quoted(str(d,"target_key"))
+     <<", LevelQ:"<<num(d,"switch_level_q")<<", LevelP:"<<num(d,"switch_level_p")<<", KeyBytes:"<<num(d,"switch_bytes")
+     <<", Parallel:"<<num(d,"parallel_factor")<<", Provided:";layout(o,field<DictionaryAttr>(d,"provided"));
+    o<<", Required:";layout(o,field<DictionaryAttr>(d,"required"));
+    auto cut=g.cutValue, use=cast<DictionaryAttr>(field<ArrayAttr>(cut,"uses")[0]), ext=g.switchingDomain;
+    o<<", Cut:epoch.CutOperand{SSA:"<<quoted(str(cut,"id"))<<", Edge:"<<quoted(str(cut,"edge_id"))<<", KeyID:"<<quoted(str(cut,"key_domain"))
+     <<", User:"<<quoted(str(use,"user"))<<", UserIndex:"<<num(use,"user_index")<<", Operand:"<<num(use,"operand")<<"}";
+    o<<", Basis:epoch.SwitchBasis{Ring:"<<num(ext,"ring_dim")<<", EmbeddedRing:"<<num(ext,"embedded_secret_ring")<<", Q:";
+    list(o,"uint64",ints(ext,"q"));o<<", P:";list(o,"uint64",ints(ext,"p"));o<<"}},\n";
+  }
+  o<<"\t\tPlain: []epoch.PlainBinding{\n";
+  for (auto [j,e]:llvm::enumerate(g.edges)) if (!e.values.empty()) {
+    auto a=g.edges[e.inputs[0]].scale;
+    o<<"\t\t\t{Index:"<<j<<", N:"<<e.n<<", Level:"<<e.level<<", LogScale:"<<number(e.op==Op::AddPlain?a:e.scale-a)<<", Values:";
+    list(o,"float64",e.values);o<<"},\n";
+  }
+  o<<"\t\t},\n\t}, evaluate)\n}\n\n";
+}
+std::string site(const Edge &e) {
+  return "gadget.Site{ID:"+quoted(e.id)+", Level:"+std::to_string(e.level)+", K:"+std::to_string(e.k)+"}";
+}
+std::string value(int64_t i) {return "v"+std::to_string(i);}
+void evaluation(llvm::raw_ostream &o,const EmitGraph &g) {
+  o<<"func evaluate(r *epoch.Runtime, input *rlwe.Ciphertext) (result *rlwe.Ciphertext, err error) {\n"
+     "\tsite := \"input\"\n\tdefer epoch.HEIRError(&site, &err)\n";
+  for(auto [j,e]:llvm::enumerate(g.edges)) {
+    std::string v=value(j), ev="r.Evaluator("+std::to_string(e.n)+")";
+    std::string a=e.inputs.empty()?"input":value(e.inputs[0]);
+    std::string pt="r.Plain("+std::to_string(j)+")";
+    o<<"\tsite = "<<quoted(e.id)<<"\n";
+    auto checked=[&] {o<<"\tif err != nil { return nil, fmt.Errorf(\"%s: %w\", site, err) }\n";};
+    switch(e.op) {
+      case Op::Source: o<<"\t"<<v<<" := input\n"; break;
+      case Op::Mask: case Op::Coefficient: o<<"\t"<<v<<" := heir.MulPlain("<<ev<<", "<<a<<", "<<pt<<")\n"; break;
+      case Op::AddPlain: o<<"\t"<<v<<" := heir.AddPlain("<<ev<<", "<<a<<", "<<pt<<")\n"; break;
+      case Op::Mul: o<<"\t"<<v<<" := heir.Mul("<<ev<<", "<<a<<", "<<value(e.inputs[1])<<")\n"; break;
+      case Op::Add:
+        o<<"\t"<<v<<" := heir.Add("<<ev<<", "<<a<<", "<<value(e.inputs[1])<<")\n";
+        for(auto i:e.inputs.drop_front(2)) o<<"\t"<<v<<" = heir.Add("<<ev<<", "<<v<<", "<<value(i)<<")\n";
+        break;
+      case Op::Rescale: o<<"\t"<<v<<" := heir.Rescale("<<ev<<", "<<a<<")\n"; break;
+      case Op::Drop: // The HEIR op takes a static attribute; the depth gap is fixed by this plan.
+        o<<"\t"<<v<<" := "<<ev<<".DropLevelNew("<<a<<", "<<g.edges[e.inputs[0]].level-e.level<<")\n";break;
+      case Op::Relin: o<<"\t"<<v<<", err := gadget.RelinearizeNew("<<ev<<", "<<a<<", "<<site(e)<<")\n";checked();break;
+      case Op::Giant: o<<"\t"<<v<<", err := gadget.Giant("<<ev<<", "<<a<<".CopyNew(), "<<e.shift<<", "<<site(e)<<")\n";checked();break;
+      case Op::Baby: {
+        const auto &group=g.hoists.at({e.site,e.inputs[0]});
+        auto h="hoist"+std::to_string(group.front());
+        if (group.front()==j) {
+          std::vector<int64_t> steps; for (auto i:group) steps.push_back(g.edges[i].shift);
+          o<<"\t"<<h<<", err := gadget.Babies("<<ev<<", "<<a<<", ";list(o,"int",steps);
+          o<<", map[int]gadget.Site{";for(auto i:group) o<<g.edges[i].shift<<":"<<site(g.edges[i])<<",";
+          o<<"})\n";checked();
+        }
+        o<<"\t"<<v<<" := "<<h<<"["<<e.shift<<"]\n";break;
+      }
+      case Op::Down: o<<"\t"<<v<<", err := r.Down("<<quoted(g.edges[e.inputs[0]].id)<<", "<<a<<")\n";checked();break;
+    }
+    o<<"\tif err = r.Check(site, "<<v<<", "<<e.n<<", "<<e.level<<", "<<number(e.scale)<<"); err != nil { return nil, err }\n";
+  }
+  o<<"\treturn "<<value(g.sink)<<", nil\n}\n";
+}
+} // namespace
+std::string renderGo(DictionaryAttr p, StringRef digest) {
+  EmitGraph g(p);
+  bool gadget=false, standard=false;
+  for (auto &e:g.edges) switch(e.op) {
+    case Op::Baby: case Op::Giant: case Op::Relin: gadget=true;break;
+    case Op::Source: case Op::Down: case Op::Drop: break;
+    default: standard=true; break;
+  }
+  std::string go;llvm::raw_string_ostream o(go);
+  o<<"// Code generated by snabf-bind-lattigo (direct-go.v1). DO NOT EDIT.\npackage planned\n\nimport (\n";
+  if (gadget||g.transition) o<<"\t\"fmt\"\n";
+  o<<"\t\"github.com/tuneinsight/lattigo/v6/core/rlwe\"\n\tepoch \"snabf.local/compiler/src/backend/ringswitch/epochs\"\n";
+  if (gadget) o<<"\t\"snabf.local/compiler/src/backend/gadget\"\n";
+  if (standard) o<<"\their \"snabf.local/compiler/src/backend/ringswitch/epochs/heirckks\"\n";
+  o<<")\n\n";bind(o,g,digest);evaluation(o,g);return go;
+}
+} // namespace snabf::ir::lattigo_target::detail
diff --git a/src/compiler/Target/Lattigo/EmitGraph.cpp b/src/compiler/Target/Lattigo/EmitGraph.cpp
new file mode 100644
index 0000000..b74b47f
--- /dev/null
+++ b/src/compiler/Target/Lattigo/EmitGraph.cpp
@@ -0,0 +1,145 @@
+#include "EmitGraph.h"
+#include "pass1/SubgroupTower.h"
+#include "llvm/ADT/StringSwitch.h"
+#include <bit>
+#include <cmath>
+
+namespace snabf::ir::lattigo_target::detail {
+namespace {
+Op opcode(StringRef s) {
+  auto op = llvm::StringSwitch<std::optional<Op>>(s)
+    .Case("source",Op::Source).Case("drop",Op::Drop).Case("mul",Op::Mul)
+    .Case("mask",Op::Mask).Case("coefficient",Op::Coefficient)
+    .Case("add_plain",Op::AddPlain).Case("add",Op::Add).Case("rescale",Op::Rescale)
+    .Case("relin",Op::Relin).Case("baby",Op::Baby).Case("giant",Op::Giant)
+    .Case("ring_down",Op::Down).Default(std::nullopt);
+  require(op.has_value(), "unsupported_direct_opcode: " + s);
+  return *op;
+}
+void periodic(DictionaryAttr d, int64_t n, int64_t width, int64_t slots,
+              int64_t level, double scale) {
+  require(num(d,"ring_dim")==n && num(d,"num_slots")==n/2 && num(d,"logical_width")==width &&
+          num(d,"stride")==1 && num(d,"period")==slots && num(d,"lane_count")==1 &&
+          str(d,"packing_mode")=="periodic_single" && ints(d,"active_lanes")==ArrayRef<int64_t>({0}) &&
+          ints(d,"offsets")==ArrayRef<int64_t>({0}) && ints(d,"mask_signature").empty() &&
+          num(d,"active_level")==level && real(d,"log2_scale")==scale,
+          "layout_not_emittable_by_periodic_downconv");
+}
+} // namespace
+
+EmitGraph::EmitGraph(DictionaryAttr p) : program(p),
+    transition(p.getAs<DictionaryAttr>("ring_decision")), source(num(p,"source_ring")),
+    target(num(p,"target_ring")), width(num(p,"width")), slots(num(p,"slots")), sink(num(p,"sink")) {
+  require(width>0 && slots>=width && slots%width==0 && std::has_single_bit(uint64_t(slots)), "unsupported_encoded_layout");
+  std::set<StringRef> keyIDs, ids;
+  for (auto a: field<ArrayAttr>(p,"epochs")) {
+    auto d=cast<DictionaryAttr>(a); auto n=num(d,"n");
+    require((n==source || n==target) && std::has_single_bit(uint64_t(n)) && n/2>=slots &&
+            !ints(d,"q").empty() && !ints(d,"p").empty() && num(d,"scale")>0 &&
+            !str(d,"key_id").empty() && keyIDs.insert(str(d,"key_id")).second &&
+            families.emplace(n,d).second,"invalid_concrete_key_domain");
+  }
+  require(families.contains(source) && families.contains(target) && (source!=target)==bool(transition),"missing_or_surplus_epoch");
+  std::map<int64_t,std::set<int64_t>> keys;
+  unsigned downs=0;
+  for (auto a: field<ArrayAttr>(p,"instructions")) {
+    auto d=cast<DictionaryAttr>(a); auto s=str(d,"ID");
+    Edge e{opcode(str(d,"op")),s.str(),num(d,"n"),num(d,"Level"),num(d,"K"),
+           real(d,"physical_log_scale"),ints(d,"inputs"),{}};
+    auto kRing=num(d,"kernel_ring");
+    require(!s.empty() && ids.insert(s).second && families.contains(e.n) && e.level>=0 &&
+            size_t(e.level)<ints(families.at(e.n),"q").size() && std::isfinite(e.scale) && e.scale>0 &&
+            e.k>=0 && e.k<=e.level, "invalid_edge_binding: " + s);
+    bool sw=e.op==Op::Down, rot=e.op==Op::Baby || e.op==Op::Giant;
+    require(kRing==(sw?source:e.n) && (e.k==0 || rot || e.op==Op::Relin),"invalid_kernel_domain_or_truncation: " + s);
+    if (transition)
+      require(str(d,"input_key_domain")==str(families.at(kRing),"key_id") &&
+              str(d,"output_key_domain")==str(families.at(e.n),"key_id") &&
+              str(d,"kernel_domain")== (sw?"switching_key_ext":kRing==source?"source":"target"),"inconsistent_direct_domain: " + s);
+    for (int64_t i:e.inputs)
+      require(i>=0 && size_t(i)<edges.size() && edges[i].n==kRing,"non_topological_or_cross_domain_operand: " + s);
+    auto arity=e.inputs.size();
+    bool sourceOp=e.op==Op::Source;
+    require(sourceOp==edges.empty() && (sourceOp ? !arity : e.op==Op::Mul ? arity==2 : e.op==Op::Add ? arity>=2 : arity==1), "invalid_direct_arity: " + s);
+    if (sourceOp) require(e.n==source && e.level==int64_t(ints(families.at(source),"q").size())-1 && e.scale==num(families.at(source),"scale"),"stale_input_binding");
+    for (auto i:e.inputs) {
+      int64_t gap=edges[i].level-e.level;
+      require(e.op==Op::Drop ? gap>=0 : e.op==Op::Rescale ? gap==1 : gap==0,"invalid_operand_level: " + s);
+    }
+    if (e.op==Op::Mask || e.op==Op::Coefficient || e.op==Op::AddPlain) {
+      e.values=field<DenseF64ArrayAttr>(d,"values").asArrayRef();
+      require(!e.values.empty() && slots%e.values.size()==0 && llvm::all_of(e.values,[](double x){return std::isfinite(x);}),"invalid_plaintext_payload: " + s);
+    }
+    if (e.op==Op::Relin) relin.insert(e.n);
+    if (rot) {
+      e.shift=num(d,"rotation"); e.site=num(d,"route_site");
+      require(e.shift>0 && e.shift<e.n/2 && e.site>=0,"unbound_rotation: " + s);
+      keys[e.n].insert(rotationElement(e.shift,std::countr_zero(uint64_t(e.n))));
+      if (e.op==Op::Baby) {
+        auto &group=hoists[{e.site,e.inputs.front()}];
+        require(llvm::none_of(group,[&](size_t j){return edges[j].shift==e.shift;}),"duplicate_hoist_rotation");
+        group.push_back(edges.size());
+      }
+    }
+    if (sw) {
+      require(transition && !downs++ && e.n==target && source>target && num(p,"cut_level")==e.level &&
+              field<BoolAttr>(transition,"emittable").getValue() && str(transition,"op_kind")=="ring_down" && num(transition,"parallel_factor")==1 &&
+              str(transition,"source_key")==str(families.at(source),"key_id") && str(transition,"target_key")==str(families.at(target),"key_id") &&
+              num(transition,"switch_level_q")==e.level && num(transition,"switch_level_p")==int64_t(ints(families.at(target),"p").size())-1 &&
+              ints(transition,"target_q")==ints(families.at(target),"q") && ints(transition,"target_p")==ints(families.at(target),"p") &&
+              edges[e.inputs.front()].scale==e.scale,"non_emittable_conversion_or_key");
+      periodic(field<DictionaryAttr>(transition,"provided"),source,width,slots,e.level,e.scale);
+      periodic(field<DictionaryAttr>(transition,"required"),target,width,slots,e.level,e.scale);
+      auto cut=field<DictionaryAttr>(transition,"cut");
+      auto values=field<ArrayAttr>(cut,"live_values");
+      require(values.size()==1 && num(cut,"ciphertext_use_count")==1,"unconverted_live_cut_value");
+      cutValue=cast<DictionaryAttr>(values[0]);
+      auto uses=field<ArrayAttr>(cutValue,"uses");
+      require(uses.size()==1 && str(cast<DictionaryAttr>(uses[0]),"role")=="main" &&
+              str(cutValue,"edge_id")==edges[e.inputs[0]].id && str(cutValue,"key_domain")==str(transition,"source_key") &&
+              num(cutValue,"ring_dim")==source && num(cutValue,"active_level")==e.level &&
+              real(cutValue,"physical_log_scale")==e.scale && cutValue.get("layout")==transition.get("provided") &&
+              ints(cutValue,"q")==ints(transition,"target_q") && ints(cutValue,"p")==ints(transition,"target_p"),"stale_direct_cut_value");
+    }
+    edges.push_back(e);
+  }
+  require(downs==unsigned(source!=target) && sink>=0 && size_t(sink)<edges.size() && edges[sink].n==target,"invalid_epoch_sink");
+  int64_t bytes=0;
+  for (auto [n,d]:families) {
+    require(llvm::equal(keys[n],ints(d,"galois")),"used_rotations_disagree_with_key_inventory");
+    bytes+=int64_t(keys[n].size())*num(d,"key_bytes");
+  }
+  if (auto search=p.getAs<DictionaryAttr>("ring_search")) {
+    auto domains=field<ArrayAttr>(search,"key_domains"); std::set<int64_t> accounted;
+    if(transition) require(domains==transition.get("key_domains"),"stale_search_key_domains");
+    for(auto a:domains) {
+      auto d=cast<DictionaryAttr>(a); auto role=str(d,"role");
+      if(role=="switching_key_ext") {
+        require(transition && !switchingDomain && str(d,"basis")=="QP" && str(d,"key_kind")=="ring_down" &&
+                field<BoolAttr>(d,"published").getValue() && num(d,"ring_dim")==source && num(d,"embedded_secret_ring")==target &&
+                str(d,"source_key")==str(transition,"source_key") && str(d,"target_key")==str(transition,"target_key") &&
+                ints(d,"q")==ints(transition,"target_q") && ints(d,"p")==ints(transition,"target_p") && num(d,"level_q")==num(transition,"switch_level_q") &&
+                num(d,"level_p")==num(transition,"switch_level_p"),"switching_key_basis_not_bound");
+        switchingDomain=d; continue;
+      }
+      auto n=num(d,"ring_dim");
+      require(families.contains(n) && accounted.insert(n).second && role==(n==source?"source":"target"),"unaccounted_execution_domain");
+      auto e=families.at(n);
+      require(str(d,"key_id")==str(e,"key_id") && ints(d,"q")==ints(e,"q") && ints(d,"p")==ints(e,"p"),"stale_execution_domain_moduli");
+      std::set<std::pair<StringRef,int64_t>> expected{{"secret",0}};
+      if(n==source)expected.emplace("public",0);
+      if(relin.contains(n))expected.emplace("relin",0);
+      for(auto key:keys[n])expected.emplace("galois",key);
+      for(auto k:field<ArrayAttr>(d,"keys")) {
+        auto key=cast<DictionaryAttr>(k);auto kind=str(key,"role");
+        require(str(key,"basis")=="QP" && field<BoolAttr>(key,"published").getValue()==(kind!="secret") &&
+                expected.erase({kind,kind=="galois"?num(key,"galois"):0})==1,"stale_domain_key_inventory");
+      }
+      require(expected.empty(),"missing_domain_key");
+    }
+    require(accounted.size()==families.size() && bool(switchingDomain)==bool(transition),"missing_execution_domain");
+  }
+  require(!transition || (cutValue && switchingDomain),"unbound_mixed_domain_or_cut");
+  require(bytes==num(p,"galois_bytes"),"stale_emitted_key_bytes");
+}
+} // namespace snabf::ir::lattigo_target::detail
diff --git a/src/compiler/Target/Lattigo/EmitGraph.h b/src/compiler/Target/Lattigo/EmitGraph.h
new file mode 100644
index 0000000..76eb230
--- /dev/null
+++ b/src/compiler/Target/Lattigo/EmitGraph.h
@@ -0,0 +1,31 @@
+#pragma once
+#include "Pipeline.h"
+#include <map>
+#include <set>
+
+namespace snabf::ir::lattigo_target::detail {
+enum class Op { Source, Drop, Mul, Mask, Coefficient, AddPlain, Add, Rescale,
+                Relin, Baby, Giant, Down };
+struct Edge {
+  Op op;
+  std::string id;
+  int64_t n, level, k;
+  double scale;
+  ArrayRef<int64_t> inputs;
+  ArrayRef<double> values;
+  int64_t shift = 0, site = -1;
+};
+struct EmitGraph {
+  explicit EmitGraph(DictionaryAttr);
+  DictionaryAttr program, transition, cutValue, switchingDomain;
+  int64_t source, target, width, slots, sink;
+  std::vector<Edge> edges;
+  std::map<int64_t, DictionaryAttr> families;
+  std::set<int64_t> relin;
+  std::map<std::pair<int64_t,int64_t>, std::vector<size_t>> hoists;
+};
+inline int64_t num(DictionaryAttr d, StringRef k) { return field<IntegerAttr>(d,k).getInt(); }
+inline double real(DictionaryAttr d, StringRef k) { return field<FloatAttr>(d,k).getValueAsDouble(); }
+inline ArrayRef<int64_t> ints(DictionaryAttr d,StringRef k) { return field<DenseI64ArrayAttr>(d,k).asArrayRef(); }
+inline StringRef str(DictionaryAttr d,StringRef k) { return field<StringAttr>(d,k).getValue(); }
+} // namespace snabf::ir::lattigo_target::detail
diff --git a/src/compiler/Target/Lattigo/EmitVerifier.cpp b/src/compiler/Target/Lattigo/EmitVerifier.cpp
new file mode 100644
index 0000000..f3a48bc
--- /dev/null
+++ b/src/compiler/Target/Lattigo/EmitVerifier.cpp
@@ -0,0 +1,147 @@
+#include "DirectEmitter.h"
+#include "Pass2IR.h"
+#include "Pass3IR.h"
+#include "Pass4IR.h"
+#include "llvm/ADT/StringExtras.h"
+#include "llvm/Support/FileSystem.h"
+#include "llvm/Support/MemoryBuffer.h"
+#include "llvm/Support/SHA256.h"
+#include <filesystem>
+
+namespace snabf::ir::lattigo_target {
+namespace {
+constexpr StringLiteral seal = "snabf.emit_sha256", epochs = "snabf.ckks_epochs",
+                        single = "snabf.ckks_direct";
+StringRef artifact(ModuleOp m) {
+  return isMixed(m) || m->hasAttr("snabf.ring_search") ? epochs : single;
+}
+Attribute existing(ModuleOp m) {
+  StringRef expected=artifact(m);
+  require(!m->hasAttr(expected==epochs?single:epochs),"wrong_lowering_domain");
+  return m->getAttr(expected);
+}
+
+void replay(ModuleOp m) {
+  if (isMixed(m)) checkRings(m);
+  else { verifyPlan(m); verifyPass3(m); checkRingSearch(m); }
+}
+
+std::string fingerprint(ModuleOp m) {
+  // Bind the entire replay input, including signed weights, SSA uses,
+  // concrete security evidence and any new Pass 4 domain/cut records. Ignore
+  // locations, the seal itself and the derived lowering so it survives MLIR I/O.
+  OwningOpRef<ModuleOp> copy(cast<ModuleOp>(m->clone()));
+  (*copy)->removeAttr(seal);
+  (*copy)->removeAttr(epochs);
+  (*copy)->removeAttr(single);
+  std::string text = "snabf.direct-go.v1\n";
+  llvm::raw_string_ostream os(text);
+  (*copy)->print(os, OpPrintingFlags().printGenericOpForm().useLocalScope());
+  return llvm::toHex(llvm::SHA256::hash(llvm::arrayRefFromStringRef(text)), true);
+}
+
+DictionaryAttr request(ModuleOp m) {
+  require(m->hasAttr("snabf.pass3") && m->hasAttr("snabf.security_screen"),
+          "direct_target_requires_concrete_screened_parameters");
+  auto proof = field<StringAttr>(m, seal);
+  replay(m);
+  require(proof.getValue() == fingerprint(m), "stale_emit_fingerprint");
+  // Unsupported operations may not disappear between the plan and Go.
+  m.walk([&](Operation *o) {
+    if (auto s = o->getAttrOfType<DictionaryAttr>("snabf.ring_switch"))
+      require(!field<BoolAttr>(s, "enabled").getValue(),
+              "bootstrap_not_emittable_in_epoch_graph");
+  });
+  return ringProgram(m);
+}
+
+// Same-directory temporaries ensure rename is atomic. The caller stages both
+// outputs and publishes the Go source last; validation never touches outputs.
+class PendingFile {
+  llvm::sys::fs::TempFile tmp;
+  std::string target;
+  bool finished = false;
+  static llvm::sys::fs::TempFile create(StringRef path) {
+    auto f = llvm::sys::fs::TempFile::create(path + ".%%%%%%.tmp");
+    if (!f) throw ContractError("cannot_stage_output: " + llvm::toString(f.takeError()));
+    return std::move(*f);
+  }
+public:
+  PendingFile(StringRef path, StringRef contents) : tmp(create(path)), target(path.str()) {
+    llvm::raw_fd_ostream out(tmp.FD, false);
+    out << contents;
+    out.flush();
+    if (out.has_error()) {
+      auto msg = out.error().message(); out.clear_error();
+      llvm::consumeError(tmp.discard());
+      throw ContractError("cannot_stage_output: " + msg);
+    }
+  }
+  void publish() {
+    if (auto err = tmp.keep(target)) throw ContractError("cannot_publish_output: " + llvm::toString(std::move(err)));
+    finished = true;
+  }
+  ~PendingFile() { if (!finished) llvm::consumeError(tmp.discard()); }
+};
+} // namespace
+
+void checkAndSeal(ModuleOp m) {
+  replay(m);
+  if (!m->hasAttr("snabf.pass3")) return; // legacy HEIR path
+  auto hash = fingerprint(m);
+  if (auto p = existing(m))
+    require(p == ringProgram(m) && field<StringAttr>(m, seal).getValue() == hash,
+            "stale_epoch_lowering");
+  m->setAttr(seal, StringAttr::get(m.getContext(), hash));
+}
+void lowerDirect(ModuleOp m) {
+  auto p = request(m);
+  if (auto old = existing(m)) require(old == p, "stale_epoch_lowering");
+  m->setAttr(artifact(m), p);
+}
+void emitDirect(ModuleOp m, StringRef goPath, StringRef auditPath) {
+  require(!goPath.empty() && goPath != "-", "direct_target_requires_ring_go_output_file");
+  namespace fs=std::filesystem;
+  auto regularOrAbsent=[](StringRef name){
+    auto st=fs::symlink_status(name.str());
+    require(st.type()==fs::file_type::not_found || fs::is_regular_file(st), "unsafe_emitter_output: "+name);
+  };
+  regularOrAbsent(goPath);
+  if (!auditPath.empty()) {
+    require(auditPath!="-","direct_target_requires_audit_file"); regularOrAbsent(auditPath);
+    require(fs::weakly_canonical(fs::absolute(goPath.str()))!=fs::weakly_canonical(fs::absolute(auditPath.str())) &&
+            !(fs::exists(goPath.str()) && fs::exists(auditPath.str()) && fs::equivalent(goPath.str(),auditPath.str())),
+            "aliased_go_and_audit_output");
+  }
+  auto p = request(m);
+  require(existing(m) == p, "stale_epoch_lowering");
+  auto hash = field<StringAttr>(m, seal).getValue();
+  auto go = detail::renderGo(p, hash);
+  PendingFile code(goPath, go);
+  if (!auditPath.empty()) {
+    auto audit = jsonPass2(p);
+    audit["emit_sha256"] = hash.str();
+    audit["emitter"] = "snabf.direct-go.v1";
+    auto text = llvm::formatv("{0:2}\n", llvm::json::Value(std::move(audit))).str();
+    PendingFile record(auditPath, text);
+    // The Go file is the publication point. Restore the previous sidecar if
+    // its publication succeeded but the final rename failed. Readers spanning
+    // both renames must compare the SHA printed in both files.
+    std::unique_ptr<PendingFile> oldAudit;
+    if (fs::exists(auditPath.str())) {
+      auto buf=llvm::MemoryBuffer::getFile(auditPath);
+      require(bool(buf),"cannot_preserve_previous_audit");
+      oldAudit=std::make_unique<PendingFile>(auditPath,(*buf)->getBuffer());
+    }
+    record.publish();
+    try { code.publish(); }
+    catch (...) {
+      if (oldAudit) oldAudit->publish();
+      else if(auto ec=llvm::sys::fs::remove(auditPath)) throw ContractError("cannot_restore_audit: "+ec.message());
+      throw;
+    }
+    return;
+  }
+  code.publish();
+}
+} // namespace snabf::ir::lattigo_target
diff --git a/src/compiler/Target/Lattigo/README.md b/src/compiler/Target/Lattigo/README.md
index 9a3337c..b08401d 100644
--- a/src/compiler/Target/Lattigo/README.md
+++ b/src/compiler/Target/Lattigo/README.md
@@ -1,21 +1,86 @@
-# Lattigo target
-
-This target is shared by Passes 1, 2 and 3. It does not select a route,
-polynomial or modulus chain. For a planned model the current pipeline is:
-
-1. The native `snabf-check-plan`, lowering and `snabf-bind-lattigo` passes
-   check and bind the plan to Lattigo IR. The binder exports the matching audit.
-2. Upstream `heir-translate --emit-lattigo` translates the verified IR to Go.
-   Its C++ implementation lives in `extern/heir/lib/Target/Lattigo/LattigoEmitter.cpp`.
-   The stock HEIR control stops here.
-3. `go-bind/` parses that Go as an AST and applies the checked SN-ABF bindings:
-   tower routes, physical coefficient scales, gadget relin sites, and periodic
-   ring-bootstrap configuration. The `key-size` subcommand only measures a
-   Lattigo key. The existing `--goemit` CLI flag is kept for callers that
-   replay recorded commands. The emitted program calls the Go kernels under
-   `src/backend/`; the pinned upstream runtime source is `extern/lattigo`.
-
-For a native SN-ABF C++ translation target, the integration point is **before
-Go is printed**: consume the checked per-operation bindings in IR, reuse HEIR
-for ordinary operations and emit the SN-ABF calls here. Then the AST binding
-step can be removed; no Pass should grow its own Go printer.
+# Lattigo Target
+
+The `ring-go` target emits one Go file in package `planned`. `planned.New()`
+binds the concrete key families and encoded constants and returns an
+`*epochs.Runtime` with `Encrypt`, `Eval`, `Decode` and `SourceEvaluation`.
+`Eval` calls the model-specific straight-line Go function. The JSON sidecar is
+an audit, never an execution input. The model has no dependency on `go-bind`.
+
+## Build and emit
+
+From the project root, using the pinned HEIR/MLIR, HiGHS and Go environment:
+
+```sh
+cmake --build "$build" --target snabf-opt
+opt="$build/ir/snabf-opt"
+# Pass 3 only: input.mlir must have the concrete profile and its security screen.
+"$opt" --allow-unregistered-dialect --snabf-check-plan \
+  --snabf-lower-ckks=direct-go input.mlir -o lowered.mlir
+# For Pass 4 use the existing --snabf-lower-ckks instead, on the output of
+# --snabf-pass4. Use the same SNABF_PASS4_ESTIMATES for each invocation.
+"$opt" --allow-unregistered-dialect \
+  '--snabf-bind-lattigo=ring-go=model.go audit=program.json' lowered.mlir -o /dev/null
+go build -mod=readonly model.go
+```
+
+The Go workspace is the project module `snabf.local/compiler` (or an external
+module requiring it with a local `replace`). `model.go` imports
+`src/backend/ringswitch/epochs`, the HEIR `heirckks` subpackage, and `gadget`
+where needed. Put separate models in separate directories/packages; do not
+merge or patch Go sources. The public `SourceEvaluation()` returns the *live*
+`(*ckks.Evaluator, ckks.Parameters, *ckks.Encoder)`, never secret keys or the
+decryptor. Its scratch buffers are not for concurrent use with `Eval`.
+For legacy equality tests encrypt once, use `ct.CopyNew()` for each path and
+the same runtime for decoding. This works for single-domain output; `Decode`
+checks the **target** domain. A switched suffix is not a source-domain result.
+
+## Boundaries
+
+* `EmitVerifier.cpp`: `snabf-check-plan` replays and issues `snabf.emit_sha256`.
+  The digest binds generic, location-free SSA including profiles, signed
+  payloads, external-screen records, decisions and cut inventories. Lowering
+  and emission independently replay the source, check the digest, and compare
+  the reconstructed lowering. A hash is a consistency check, not an attestation
+  by a trusted signer. Historical IR without a receipt must be rechecked.
+* `RingEmitter.cpp`: pairs physical Pass 3 edges with the selected tower's
+  signed HEIR diagonal tables and the actual Pass 2 coefficients. Buffer
+  domains come from the verified graph, not textual order around a conversion.
+* `EmitGraph.*`: checks topological order, arity, operand domains, levels,
+  geometric rotation-to-Galois inventory and byte count. A down edge must bind
+  to the sole converted live operand, its layout and the screened extended QP.
+* `DirectGo.cpp`: emits the typed `epochs.Program` literal and one static Go
+  call per selected edge. Hoisted babies share one call per (route site, SSA
+  input), preserving every rotation's `K`. The nonlinear DAG, scalar encodes,
+  residual drops, relins and rescales are materialized, not refitted here.
+  Go verifies actual ring, level, physical scale and slot shape at every edge.
+* `StandardCKKS.mlir` supplies HEIR's ordinary Add/AddPlain/Mul/MulPlain/Rescale
+  functions. `scheme.ckks` is on the physical module. `standard.go` is the
+  unmodified output of pinned `heir-translate --emit-lattigo --package-name=heirckks`;
+  do not gofmt it. The static level-drop count uses `DropLevelNew` directly.
+  Upstream errors from helpers are returned by `Eval` with their concrete site.
+* The target stages both files before publishing, replaces each by rename,
+  and publishes Go last. Use one writer per output path. A concurrent reader
+  should match `planned.PlanSHA256` to `emit_sha256` in the sidecar: a pair of
+  ordinary files is not a filesystem-wide transaction. Failed checks preserve
+  existing output files.
+
+## Verification
+
+```sh
+HEIR_TRANSLATE="$heir/heir-translate" bash src/compiler/Target/Lattigo/regenerate-heir-helpers.sh --check
+go test -mod=readonly -count=1 ./src/backend/ringswitch/epochs/...
+python3 src/compiler/Target/Lattigo/test-direct-gate.py "$opt" current.mlir
+SNABF_PASS4_ESTIMATES="$security" python3 src/compiler/Target/Lattigo/test-direct-gate.py "$opt" current.mlir --pass4
+```
+
+Use `--write` instead of `--check` only to regenerate the public helper. With
+the locked `heir-py 2026.11.1` translator the raw helper SHA-256 is
+`3ba17babf49e6153724b374ebc22232f047121a9094c841fa8512c8c8d3f3102`.
+
+The direct ABI supports one periodic vector, one sink and, when selected,
+one checked trace-invariant down conversion. Missing concrete Pass 3 records,
+arbitrary packing, multi-ciphertext repacking, and bootstraps inside this
+epoch graph are not silently translated. The separate historical Pass 1
+periodic bootstrap and legacy HEIR comparison scripts still use `go-bind/`;
+the stock HEIR control remains unmodified. A successful emission is not
+an end-to-end error probability proof or a performance result.
