diff --git a/src/compiler/pass4/SSACut.h b/src/compiler/pass4/SSACut.h
new file mode 100644
index 0000000..1dc998b
--- /dev/null
+++ b/src/compiler/pass4/SSACut.h
@@ -0,0 +1,70 @@
+#pragma once
+#include "mlir/IR/Operation.h"
+#include "llvm/ADT/DenseMap.h"
+#include "llvm/ADT/DenseSet.h"
+#include "llvm/ADT/STLExtras.h"
+#include <stdexcept>
+
+namespace snabf::pass4 {
+struct CrossingUse {
+  mlir::OpOperand *use;
+  bool reachesResidualJoin;
+};
+struct BlockCut {
+  llvm::DenseMap<mlir::Operation *, unsigned> order;
+  llvm::SmallVector<CrossingUse> uses;
+};
+
+// All uses crossing the program point immediately before 'first'. The forward
+// and reverse sweeps classify only joins downstream of 'main', not any add.
+inline BlockCut enumerateCut(mlir::Operation *first, mlir::Operation *main,
+                             llvm::function_ref<bool(mlir::Type)> encrypted,
+                             llvm::function_ref<bool(mlir::Operation *)> join) {
+  using namespace mlir;
+  auto *block = first->getBlock();
+  if (!block || main->getBlock() != block || !block->getParent()->hasOneBlock())
+    throw std::invalid_argument("unsupported_multiblock_encrypted_cut");
+  BlockCut cut;
+  for (auto [i, op] : llvm::enumerate(*block))
+    cut.order[&op] = i;
+  auto pos = [&](Operation *o) { return cut.order.find(o)->second; };
+  llvm::DenseSet<Operation *> fromMain{main}, reachesJoin;
+  for (Operation &op : *block) {
+    if (pos(&op) < pos(first))
+      continue;
+    if (op.getNumRegions())
+      throw std::invalid_argument("unsupported_nested_suffix_cut");
+    for (Value v : op.getOperands())
+      if (encrypted(v.getType()) && fromMain.contains(v.getDefiningOp()))
+        fromMain.insert(&op);
+    if (fromMain.contains(&op) && join(&op))
+      reachesJoin.insert(&op);
+  }
+  for (Operation &op : llvm::reverse(*block)) {
+    if (pos(&op) < pos(first))
+      break;
+    if (!reachesJoin.contains(&op))
+      continue;
+    for (Value v : op.getOperands()) {
+      auto *def = v.getDefiningOp();
+      if (encrypted(v.getType()) && def && def->getBlock() == block &&
+          pos(def) >= pos(first))
+        reachesJoin.insert(def);
+    }
+  }
+  for (Operation &op : *block) {
+    if (pos(&op) < pos(first))
+      continue;
+    for (auto &u : op.getOpOperands()) {
+      Value v = u.get();
+      auto *def = v.getDefiningOp();
+      if (def ? def->getBlock() != block
+              : cast<BlockArgument>(v).getOwner() != block)
+        throw std::invalid_argument("unsupported_nonlocal_cut_operand");
+      if (!def || pos(def) < pos(first))
+        cut.uses.push_back({&u, reachesJoin.contains(&op)});
+    }
+  }
+  return cut;
+}
+} // namespace snabf::pass4
diff --git a/src/compiler/pass4/tests/SSACutTest.cpp b/src/compiler/pass4/tests/SSACutTest.cpp
new file mode 100644
index 0000000..3f1a6cf
--- /dev/null
+++ b/src/compiler/pass4/tests/SSACutTest.cpp
@@ -0,0 +1,72 @@
+#include "pass4/SSACut.h"
+#include "mlir/IR/Builders.h"
+#include "mlir/IR/BuiltinOps.h"
+#include <iostream>
+
+using namespace mlir;
+
+// Exercise the same block cut used by Pass4IR with actual MLIR Values and
+// OpOperands. Numeric types here merely distinguish encrypted and public ports.
+static void check(unsigned shape, unsigned expectedValues,
+                  unsigned expectedUses, unsigned expectedBypasses) {
+  MLIRContext ctx;
+  ctx.allowUnregisteredDialects();
+  OpBuilder b(&ctx);
+  auto loc = b.getUnknownLoc();
+  OwningOpRef<ModuleOp> m(ModuleOp::create(loc));
+  b.setInsertionPointToStart(m->getBody());
+  auto op = [&](StringRef name, ValueRange args, Type t) {
+    OperationState state(loc, name);
+    state.addOperands(args);
+    state.addTypes(t);
+    return b.create(state);
+  };
+  auto ct = b.getI32Type();
+  Value x = op("test.source", {}, ct)->getResult(0);
+  Value y = op("test.poly", x, ct)->getResult(0);
+  Value table = op("test.table", {}, b.getF64Type())->getResult(0);
+  if (shape == 1)
+    y = op("test.add", {x, y}, ct)->getResult(0); // pre-merged residual
+  auto main = op("test.lin", {y, table}, ct);
+  Value output = main->getResult(0);
+  if (shape == 2)
+    output = op("test.add", {output, x}, ct)->getResult(0); // distinct values
+  if (shape == 3)
+    output =
+        op("test.add", {output, y}, ct)->getResult(0); // same value, two uses
+  if (shape == 4)
+    output = op("test.add", {output, op("test.align", x, ct)->getResult(0)}, ct)
+                 ->getResult(0);
+  if (shape == 5)
+    op("test.add", {x, x}, ct); // foreign add, not downstream of main
+  op("test.sink", output, ct);
+  auto cut = snabf::pass4::enumerateCut(
+      main, main, [&](Type t) { return t == ct; },
+      [&](Operation *o) { return o->getName().getStringRef() == "test.add"; });
+  llvm::DenseSet<Value> live;
+  unsigned uses = 0, publics = 0, bypasses = 0;
+  for (auto item : cut.uses) {
+    Value value = item.use->get();
+    if (value == table) {
+      ++publics;
+      continue;
+    }
+    ++uses;
+    live.insert(value);
+    if (item.use->getOwner() != main && item.reachesResidualJoin)
+      ++bypasses;
+  }
+  if (publics != 1 || live.size() != expectedValues || uses != expectedUses ||
+      bypasses != expectedBypasses)
+    throw std::runtime_error("incorrect SSA cut for shape " +
+                             std::to_string(shape));
+}
+int main() {
+  check(0, 1, 1, 0);
+  check(1, 1, 1, 0);
+  check(2, 2, 2, 1);
+  check(3, 1, 2, 1);
+  check(4, 2, 2, 1);
+  check(5, 2, 3, 0);
+  std::cout << "6 MLIR SSA cut cases passed\n";
+}
