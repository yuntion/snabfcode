        %10 = arith.subi %8, %9 : i32
        %11 = arith.index_cast %10 : i32 to index
        %extracted_0 = tensor.extract %1[%c0, %11] : tensor<1x4096xf32>
        %12 = arith.index_cast %3 : i32 to index
        %inserted = tensor.insert %extracted_0 into %arg5[%12] : tensor<64xf32>
