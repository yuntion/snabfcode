# Compile the upstream Lattigo dialect itself; do not weaken memref element
# verification or model HEIR's backend types as opaque stand-ins.
get_filename_component(default_heir "${CMAKE_CURRENT_SOURCE_DIR}/../../../extern/heir" ABSOLUTE)
# Do not shadow an existing -DHEIR cache entry during automatic reconfigure.
set(HEIR "${default_heir}" CACHE PATH "Pinned HEIR checkout")
set(hgen "${gen}/heir-inc")
foreach(tree mlir llvm)
  file(MAKE_DIRECTORY "${hgen}/${tree}")
  if(NOT EXISTS "${hgen}/${tree}/include")
    file(CREATE_LINK "${sdk}/include" "${hgen}/${tree}/include" SYMBOLIC)
  endif()
endforeach()
set(lat lib/Dialect/Lattigo/IR)
set(sec lib/Dialect/Secret/IR)
function(heir_gen base input generator flag)
  get_filename_component(dir "${hgen}/${base}" DIRECTORY)
  file(MAKE_DIRECTORY "${dir}")
  foreach(ext h cpp)
    if(ext STREQUAL "h")
      set(t decls)
    else()
      set(t defs)
    endif()
    set(out "${hgen}/${base}.${ext}.inc")
    add_custom_command(OUTPUT "${out}" COMMAND "${sdk}/bin/mlir-tblgen" "-gen-${generator}-${t}" ${flag}
      -I "${sdk}/include" -I "${HEIR}" -I "${HEIR}/${lat}" -I "${HEIR}/${sec}"
      "${HEIR}/${input}.td" -o "${out}" -d "${out}.d" DEPFILE "${out}.d" DEPENDS "${HEIR}/${input}.td" VERBATIM)
    list(APPEND hg "${out}")
  endforeach()
  set(hg "${hg}" PARENT_SCOPE)
endfunction()
foreach(pair "LattigoDialect;dialect" "LattigoTypes;typedef" "LattigoAttributes;attrdef" "LattigoOps;op")
  list(GET pair 0 file)
  list(GET pair 1 mode)
  heir_gen("${lat}/${file}" "${lat}/${file}" "${mode}" "")
endforeach()
heir_gen("${sec}/SecretDialect" "${sec}/SecretDialect" dialect "")
heir_gen("${sec}/SecretAttributes" "${sec}/SecretAttributes" attrdef "")
foreach(pair "Attr;attr" "Op;op" "Type;type")
  list(GET pair 0 name)
  list(GET pair 1 mode)
  heir_gen("lib/Dialect/HEIR${name}Interfaces" lib/Dialect/HEIRInterfaces "${mode}-interface" "")
endforeach()
heir_gen(lib/Utils/Tablegen/InPlaceOpInterface lib/Utils/Tablegen/InPlaceOpInterface op-interface "")
add_library(heir_lattigo STATIC ${hg} "${HEIR}/${lat}/LattigoDialect.cpp" "${HEIR}/${lat}/LattigoOps.cpp"
  "${HEIR}/lib/Dialect/HEIRInterfaces.cpp" "${HEIR}/lib/Utils/Tablegen/InPlaceOpInterface.cpp"
  "${HEIR}/lib/Utils/Utils.cpp" "${HEIR}/lib/Utils/MathUtils.cpp" "${HEIR}/lib/Utils/APIntUtils.cpp")
target_compile_features(heir_lattigo PUBLIC cxx_std_20)
target_compile_options(heir_lattigo PRIVATE -O1 -ffunction-sections -fdata-sections)
target_include_directories(heir_lattigo SYSTEM PUBLIC "${HEIR}" "${hgen}" "${sdk}/include")
target_link_options(heir_lattigo INTERFACE -Wl,--gc-sections)
