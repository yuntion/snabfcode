// Code generated by the SN-ABF native single-ring backend.
package planned

import (
    "crypto/sha256"
    _ "embed"
    "encoding/binary"
    "encoding/hex"
    "encoding/json"
    "fmt"
    "math"
    "math/big"
    "math/bits"
    "slices"
    "strconv"

    "github.com/tuneinsight/lattigo/v6/core/rlwe"
    "github.com/tuneinsight/lattigo/v6/schemes/ckks"
)

//go:embed program.json
var nativeProgram string

type nativePlain struct { Meta, Effective, Branch, SHA string; Precision int; Bits []string }
type nativeEdge struct { ID, Op, Meta string; Level int; Inputs []int; Plain *nativePlain }
type nativeProgramSpec struct { Ring, Slots, Width, Scale, Sink int; Q,P []uint64; Edges []nativeEdge; Domain []float64 `json:"input_domain"`; Seal string `json:"emit_sha256"` }
type NativeRuntime struct { spec nativeProgramSpec; params ckks.Parameters; ev *ckks.Evaluator; enc *ckks.Encoder; plain map[int]*rlwe.Plaintext; scales []rlwe.Scale }

func nativeRat(text string)(*big.Rat,error) {
    q,ok:=new(big.Rat).SetString(text)
    if !ok || q.Sign()<=0 || q.RatString()!=text {return nil,fmt.Errorf("missing or noncanonical rational")};return q,nil
}
func nativeScale(text string)(rlwe.Scale,error){
    q,err:=nativeRat(text);if err!=nil{return rlwe.Scale{},err};v:=new(big.Float).SetPrec(rlwe.ScalePrecision).SetRat(q)
    back,_:=v.Rat(nil);if back.Cmp(q)!=0{return rlwe.Scale{},fmt.Errorf("inexact metadata")};return rlwe.NewScale(v),nil
}

// The caller supplies keys for the checked single-ring parameter family. No
// secret-key material is needed by the generated evaluator or public weights.
func BindNative(p ckks.Parameters, ev *ckks.Evaluator)(*NativeRuntime,error){
    hash:=sha256.Sum256([]byte(nativeProgram));if hex.EncodeToString(hash[:])!=NativeProgramFileSHA256 || ev==nil{return nil,fmt.Errorf("unbound plan/evaluator")}
    var s nativeProgramSpec;if err:=json.Unmarshal([]byte(nativeProgram),&s);err!=nil{return nil,err}
    if s.Seal!=PlanSHA256 || p.N()!=s.Ring || !slices.Equal(p.Q(),s.Q) || !slices.Equal(p.P(),s.P) || !ev.GetParameters().Equal(&p) ||
       p.LogDefaultScale()!=s.Scale || len(s.Edges)==0 || s.Slots<1 || s.Slots>p.MaxSlots() || s.Slots&(s.Slots-1)!=0 ||
       s.Width<1 || s.Slots%s.Width!=0 || len(s.Domain)!=2 || s.Domain[0]>s.Domain[1] {return nil,fmt.Errorf("wrong concrete domain/layout")}
    r:=&NativeRuntime{s,p,ev,ckks.NewEncoder(p),map[int]*rlwe.Plaintext{},make([]rlwe.Scale,len(s.Edges))}
    for i,e:=range s.Edges {
        var err error;r.scales[i],err=nativeScale(e.Meta);if err!=nil{return nil,err}
        if e.Plain==nil{continue}; b:=e.Plain
        if b.Precision!=int(r.enc.Prec()) || b.Precision!=53 || b.Branch!="embed_double_f64" {return nil,fmt.Errorf("%s: wrong encode branch",e.ID)}
        pt:=ckks.NewPlaintext(p,e.Level);pt.LogDimensions.Cols=bits.TrailingZeros(uint(s.Slots));pt.Scale,err=nativeScale(b.Meta);if err!=nil{return nil,err}
        eff,err:=nativeRat(b.Effective);if err!=nil{return nil,err};asFloat,_:=pt.Scale.Value.Float64();actual:=new(big.Rat).SetFloat64(asFloat)
        if !pt.IsBatched || actual==nil || actual.Cmp(eff)!=0{return nil,fmt.Errorf("%s: wrong effective encode scale",e.ID)}
        if e.Op=="source" {if i!=0 || len(b.Bits)!=0 || b.SHA!="" || !pt.Scale.Equal(p.DefaultScale()){return nil,fmt.Errorf("wrong input scale")};continue}
        if len(b.Bits)==0 || s.Width%len(b.Bits)!=0{return nil,fmt.Errorf("unbound public plaintext")}
        v:=make([]float64,s.Slots);h:=sha256.New();var bytes [8]byte
        for j:=range v{u,err:=strconv.ParseUint(b.Bits[j%len(b.Bits)],16,64);if err!=nil{return nil,err};binary.BigEndian.PutUint64(bytes[:],u);h.Write(bytes[:]);v[j]=math.Float64frombits(u)}
        if hex.EncodeToString(h.Sum(nil))!=b.SHA{return nil,fmt.Errorf("%s: changed public payload",e.ID)}
        if err=r.enc.Encode(v,pt);err!=nil{return nil,err};r.plain[i]=pt
    }
    return r,nil
}
func (r *NativeRuntime) EncodeInput(x []float64)(*rlwe.Plaintext,error){
    s:=r.spec;if len(x)!=s.Width{return nil,fmt.Errorf("wrong input width")};v:=make([]float64,s.Slots)
    for i:=range v{a:=x[i%s.Width];if math.IsNaN(a)||a<s.Domain[0]||a>s.Domain[1]{return nil,fmt.Errorf("input outside declared domain")};v[i]=a}
    pt:=ckks.NewPlaintext(r.params,s.Edges[0].Level);pt.LogDimensions.Cols=bits.TrailingZeros(uint(s.Slots))
    if !pt.Scale.Equal(r.scales[0]){return nil,fmt.Errorf("wrong source encoding scale")};return pt,r.enc.Encode(v,pt)
}
func (r *NativeRuntime) Eval(x *rlwe.Ciphertext)(*rlwe.Ciphertext,error){
    return EvaluateNative(r.ev,x,r.plain,func(i int,v *rlwe.Ciphertext)error{
        e:=r.spec.Edges[i];degree:=1;if e.Op=="mul"{degree=2}
        if v==nil||v.MetaData==nil||len(v.Value)!=degree+1||v.Value[0].N()!=r.params.N()||v.Level()!=e.Level||v.LogDimensions.Rows!=0||v.Slots()!=r.spec.Slots||
           !v.IsNTT||!v.IsBatched||v.Scale.Mod!=nil||v.Scale.Value.Prec()!=rlwe.ScalePrecision||!v.Scale.Equal(r.scales[i]){return fmt.Errorf("%s: live ciphertext does not match native plan",e.ID)};return nil})
}
