package planned

import (
	"encoding/json"
	"math"
	"os"
	"testing"
)

func TestUnseenStaticGraph(t *testing.T) {
	var cases []struct{ X, Y []float64 }
	data, err := os.ReadFile(os.Getenv("SNABF_TEST_ORACLE"))
	if err != nil {
		t.Fatal(err)
	}
	if err = json.Unmarshal(data, &cases); err != nil || len(cases) == 0 {
		t.Fatal("invalid corpus", err)
	}
	r, err := New()
	if err != nil {
		t.Fatal(err)
	}
	var peak, ss float64
	var count int
	for _, v := range cases {
		ct, err := r.Encrypt(v.X)
		if err != nil {
			t.Fatal(err)
		}
		out, err := r.Eval(ct)
		if err != nil {
			t.Fatal(err)
		}
		got, err := r.Decode(out)
		if err != nil {
			t.Fatal(err)
		}
		if len(v.Y) != r.Program.Width || len(got) != r.Program.Slots {
			t.Fatal("slot shape")
		}
		for j, x := range got {
			d := math.Abs(x - v.Y[j%len(v.Y)])
			if !(d <= 1.0/4096) {
				t.Fatalf("slot %d: %g vs %g", j, x, v.Y[j%len(v.Y)])
			}
			peak = math.Max(peak, d)
			ss += d * d
			count++
		}
		t.Logf("level=%d log2(scale)=%.8f", out.Level(), out.LogScale())
	}
	t.Logf("inputs=%d slot_checks=%d Linf=%.9g MSE=%.9g", len(cases), count, peak, ss/float64(count))
}
